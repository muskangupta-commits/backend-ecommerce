# Backend environment — copy to .env and fill in real values
# NEVER commit .env to version control

API_V1_PREFIX=/api/v1
APP_NAME=Cartify E-Commerce API
ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ecommerce_db?retryWrites=true&w=majority
MONGODB_DATABASE=ecommerce_db

# Token Encryption (AES-256-CBC) & Expiration (7 Days)
ENCRYPTION_ALGORITHM=aes-256-cbc
ENCRYPTION_FIXED_KEY=0123456789abcdef0123456789abcdef
ENCRYPTION_FIXED_IV=abcdef9876543210
TOKEN_EXPIRE_DAYS=7

# Demo OTP (development only — never use in production)
DEMO_OTP=123456
DEMO_OTP_ENABLED=true
